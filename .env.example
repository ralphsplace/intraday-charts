# Copy to .env and fill in. The collector and the tools use the IB_* settings.

# Address of the PC running TWS:
#   - host.docker.internal (default): TWS runs on the machine running Docker. Docker's *.docker.internal
#     names are always accepted; docker-compose.yml defines host.docker.internal on Linux too.
#   - its LAN address, e.g. 192.168.1.50, when Docker runs on another machine (e.g. the NAS)
IB_HOST=host.docker.internal
# TWS API port: 7496 live (market data subscriptions belong to the live account), 7497 paper
IB_PORT=7496
# Any number not used by another API program connected to the same TWS
IB_CLIENT_ID=17
SYMBOLS=QQQ SPY
# Market indexes fetched with every stock request, for the TICK studies. Add TICK-NDX (the Nasdaq-100 TICK)
# if your IBKR account has real-time Nasdaq index data.
COMPANIONS=TICK-NYSE TRIN-NYSE
BACKFILL_DAYS=30
# Years of daily prices kept per symbol, for 1d / 1w / 1M charts and long daily averages. Raising it fetches the
# extra history once; after that only the last month is fetched to stay up to date.
DAILY_YEARS=10
# Recorded from live quotes in Live mode, for the Internals dashboard: NYSE advance-decline (ADD-NYSE) and up minus
# down volume (VOLD-NYSE). IBKR has no history for these, so history starts when recording starts. Empty: off.
RECORD=ADD-NYSE VOLD-NYSE
# Earnings page: the collector looks up earnings dates on SEC EDGAR (public company filings). The SEC requires
# every program to name a contact in its requests: your name and email, e.g. "Jane Doe jane@example.com".
# Leave empty to turn the lookups off (dates can still be written by hand; docs/earnings.md).
SEC_CONTACT=
# Live mode: seconds between writes of today's bars
LIVE_WRITE_SECONDS=5
CHART_PORT=8050
# processes serving charts; raise on a NAS with more cores if large grids replay slowly
WEB_WORKERS=2

# --- Security (docs/security.md) ---
# Devices allowed to use the dashboard. Empty = loopback plus the private home-network ranges
# (10.x, 172.16-31.x, 192.168.x). Narrow it to your subnet or devices, e.g. 192.168.1.0/24.
# Internet ranges are refused: the server won't start.
ALLOWED_NETWORKS=
# Extra names you use to reach the NAS (IP addresses, machine names like "nas" and .local/.lan names work already)
ALLOWED_HOSTS=
# NAS address to listen on, e.g. 192.168.1.10 (default: all of the NAS's addresses)
CHART_BIND=0.0.0.0
# The user the containers run as (match the owner of the data folder on the NAS if you like)
APP_UID=1000
APP_GID=1000
